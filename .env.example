# Copy to `.env`. Real environment variables always win over this file, so a
# container orchestrator or a CI secret beats a checked-out copy.

APP_NAME="Rainier Sample"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Encryption and signing. Generate one with `cargo run -- key:generate`.
# Without it a random key is minted per boot, so nothing encrypted survives a
# restart — including sessions in the database driver.
APP_KEY=

# Retired keys, comma-separated. Still needed to read what they wrote, so a
# rotation is: move the old APP_KEY here, put a new one above, deploy.
APP_PREVIOUS_KEYS=

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# SQLite in memory needs no setup and is wiped on exit. Point this at
# `sqlite://database.sqlite?mode=rwc`, MySQL or Postgres to keep data —
# nothing else in the app changes.
DATABASE_URL=sqlite::memory:

# sync | database | bulk — one of the connections config/queue.rs declares.
#
# sync runs jobs inline (development only — a failed job fails the request).
# Switch to `database` and run `cargo run -- queue:work` for real queueing;
# its tables are already in the migrations. `bulk` is the same driver on its
# own connection, so a long import can be drained by its own workers without
# delaying a password-reset email.
#
# This is QUEUE_CONNECTION and not QUEUE_DRIVER, and the difference is a boot
# failure rather than a preference. QUEUE_DRIVER names a single connection;
# config/queue.rs declares three. Rainier refuses the two together instead of
# picking one, because a dispatch to whichever lost is still accepted, still
# returns an id, and then waits somewhere nothing drains. If you have an older
# .env with QUEUE_DRIVER in it, delete the line — *delete*, not blank. An empty
# value is its own error, deliberately: `FOO=$UNSET_VAR` in a compose file
# produces one nobody wrote, and reading it as "unset" would silently pick a
# default. Rainier says so by name if you try.
QUEUE_CONNECTION=sync

# log | file | memory | smtp | ses | postmark | mailgun | sendgrid | resend
#
# The first three deliver nothing — `file` writes .eml files you can open in
# a browser. The senders each need a cargo feature (mail-smtp, mail-ses, …)
# and their settings below; selecting one without its feature fails the boot
# naming it. For development against a real SMTP conversation:
#
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
#   MAIL_DRIVER=smtp MAIL_HOST=localhost MAIL_PORT=1025 MAIL_ENCRYPTION=none
#
MAIL_DRIVER=log
MAIL_FILE_PATH=storage/mail
MAIL_FROM=hello@example.com
MAIL_FROM_NAME="Rainier Sample"
# Set in staging and leave it set: every message goes here instead of to its
# real recipients.
MAIL_ALWAYS_TO=
# smtp. MAIL_PORT=0 means "whatever MAIL_ENCRYPTION's arrangement uses":
# 587 for starttls (a *required* upgrade), 465 for tls, 25 for none.
MAIL_HOST=
MAIL_PORT=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_TIMEOUT=30
# The API providers, one credential each. ses has no entry here: region and
# credentials come from the AWS default chain (AWS_REGION, a profile, IMDS).
MAIL_POSTMARK_TOKEN=
MAIL_MAILGUN_DOMAIN=
MAIL_MAILGUN_SECRET=
MAIL_MAILGUN_ENDPOINT=
MAIL_SENDGRID_KEY=
MAIL_RESEND_KEY=

# memory | database | cache | cookie
#
#   memory    per-process — fine for one instance, wrong for two, because a
#             user's session appears to vanish as the load balancer moves them
#   database  needs the session table; see database/migrations.rs. Never evicts.
#   cache     one of the stores config/cache.rs declares, named by SESSION_STORE
#             below (empty means whatever CACHE_STORE names). Expires sessions
#             itself, but a cache under pressure can evict a live one — which is
#             why SESSION_REDIS_URL exists
#   cookie    the whole session encrypted in the cookie. No server state — and
#             so no way to revoke a session. Needs APP_KEY.
SESSION_DRIVER=memory
# Which declared cache store holds sessions, when SESSION_DRIVER=cache.
# Empty means the one CACHE_STORE names.
SESSION_STORE=
SESSION_COOKIE=rainier_session
SESSION_LIFETIME=7200
# Turn this on in production. A session cookie over plain HTTP is a session
# anyone on the path can take.
SESSION_SECURE=false


# memory | shared | sessions — one of the stores config/cache.rs declares.
#
# `shared` and `sessions` exist only when the URLs below name a server, and
# each needs the `redis` cargo feature: `cargo run --features redis`. A store
# that names a driver this build does not carry fails the boot rather than
# quietly becoming an in-process cache — which would be a lock that holds in
# one replica and nowhere else, and a rate limit that counts to its limit once
# per replica.
#
# CACHE_STORE and not CACHE_DRIVER, for the reason QUEUE_CONNECTION is not
# QUEUE_DRIVER above: the two are refused together. If you have an older .env
# with CACHE_DRIVER in it, delete the line. (`.env.build`, which sizes the
# Docker image, is the one place the driver name is still spelled — it never
# reaches the running container. See the Dockerfile.)
CACHE_STORE=memory

# Leave empty to run with no Redis at all. One URL, or a comma-separated seed
# list for a cluster.
REDIS_URL=

# Sessions get their own server when this names one, because a cache wants to
# evict under memory pressure and a session store must not — evicting a session
# signs somebody out. Empty means sessions share whatever CACHE_STORE names.
SESSION_REDIS_URL=

# An alternative to `shared` rather than a companion to it: naming this declares
# a `memcached` store you would point CACHE_STORE at instead. Needs the
# `memcached` cargo feature.
MEMCACHED_URL=

POSTS_PER_PAGE=15

# Extra browser origins the API accepts, comma-separated — a preview
# deployment, a partner embed. **Appended** to the list config/cors.rs declares,
# never replacing it, so one hurried entry here cannot lock the real front end
# out.
#
# There is no `*`, and writing one is warned about and dropped rather than
# honoured. It is not the permissive end of this setting: the API answers
# `Access-Control-Allow-Credentials`, and no browser accepts that beside
# `Access-Control-Allow-Origin: *`. Naming origins is what makes credentials
# possible, and credentials are what make a cookie arrive at all — so a
# wildcard would not loosen the policy, it would stop browser clients
# authenticating. See config/cors.rs.
#
# Note there is no CORS_ALLOW_CREDENTIALS to go with it, deliberately: the two
# are one decision, and a deployment that could set them apart would.
CORS_ALLOWED_ORIGINS=

RUST_LOG=info

# argon2id | bcrypt — which algorithm password hashing WRITES. Verification
# reads every registered algorithm by the stored hash's own prefix, so
# changing this is a deploy and rows convert on their next successful login.
# bcrypt needs the `bcrypt` cargo feature.
HASH_DRIVER=argon2id

# native | php — which encryption envelope Crypt writes. `php` exists for a
# database a PHP application already filled; it is a migration position, not
# a destination.
APP_CIPHER=native

# Where uploaded files live. config/storage.rs always declares an `uploads`
# disk under STORAGE_ROOT — it survives a restart and not a redeploy — and adds
# a `documents` disk when STORAGE_BUCKET names one (cargo feature `s3`).
# STORAGE_ENDPOINT points the same driver at Cloudflare R2 or MinIO instead of
# AWS, and FILESYSTEM_DISK picks which disk is the default.
#
# There is no STORAGE_DRIVER: a disk names its own driver inside the section.
# Unlike CACHE_DRIVER and QUEUE_DRIVER this one is merely ignored rather than
# refused, so a leftover line in an old .env is quiet — check here rather than
# wondering why changing it does nothing.
#
# It does still belong in .env.build, which sizes the Docker image: an `s3` disk
# declared in the section has nothing else to announce it, so leaving it out
# builds an image with no S3 client and the failure arrives on the first upload.
FILESYSTEM_DISK=uploads
STORAGE_ROOT=storage/app
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_URL_PREFIX=

# A second object store on its own service, with its own credentials — declared
# only when both the bucket and the endpoint are present. See config/storage.rs
# for why half a configuration is worse than none.
ARCHIVE_BUCKET=
ARCHIVE_ENDPOINT=
ARCHIVE_REGION=auto
ARCHIVE_ACCESS_KEY_ID=
ARCHIVE_SECRET_ACCESS_KEY=

# Naming a queue here declares an `sqs` connection you can point
# QUEUE_CONNECTION at (cargo feature `sqs`). Credentials come from the SDK's
# default chain — env vars, IRSA, a profile, instance metadata. SQS_ENDPOINT
# points the same driver at ElasticMQ or LocalStack instead of AWS.
SQS_QUEUE_URL=
SQS_ENDPOINT=

# One cluster, two ports: broadcasting and the socket relay read this section
# (cargo feature `kafka`, plus `kafka-tls` for a managed cluster). Empty brokers
# mean no cluster is configured.
#
# Kafka does not currently back the queue here, and config/queue.rs says why: a
# declared Kafka connection carries brokers, a group, a topic prefix and a lease
# and has no field for the TLS and SASL settings below — so it would connect in
# the clear to a cluster configured for neither.
KAFKA_BROKERS=
KAFKA_GROUP=app
KAFKA_TOPIC_PREFIX=app
KAFKA_BROADCAST_TOPIC=app.broadcast
KAFKA_TLS=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=
