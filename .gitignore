# Build artifacts
/target
**/*.rs.bk

# Local configuration and secrets
.env

# Frontend: dependencies and Vite's output. `public/hot` is the dev server's
# marker and must never be committed — a stale one points every page at a
# dev server that is gone.
/node_modules
/public/build
/public/hot

# Runtime output
/storage/logs/*
!/storage/logs/.gitkeep
/storage/mail/*
!/storage/mail/.gitkeep
*.sqlite
*.sqlite-journal

# Editors
/.idea
/.vscode
*.iml

# OS
.DS_Store
Thumbs.db

# Local development overrides (see .cargo/config.toml)
/.cargo
